# rr linux build trees: upstream socfpga clones (u-boot-socfpga, linux-socfpga,
# arm-trusted-firmware) + generated outputs. Regenerated by `rr linux fetch-sw`
# / `rr linux *`. NEVER commit these (multi-GB).
/sw/linux/src/
/sw/linux/out/

# Optional extra rootfs overlay tree (custom files layered onto the rootfs).
/sw/linux/rootfs_overlay/

# Quartus Pro synth→fit→bitstream + qsys/HPS build artefacts (regenerated by rr)
/project/
/bitstream/
/reports/
/qdb/
/.Xil/
/build/
/build_env.mk
/build_env.tcl
/.deps.ok
/.routertl/
/.routertl_cache/

# qsys / HPS-subsystem generation (regenerated by `rr` from ip.yml + the tracked
# .ip descriptors). The ip/<name>/<name>.ip files ARE source; their generated
# instance dirs and the qsys scripts are not.
/Makefile
/dni/
/hps_subsys.qsys
/hps_subsys/
/hps_subsys_qsys_script.qpf
/hps_subsys_qsys_script.qsf
/hps_subsys_qsys_script.tcl
/ip/agilex_hps/agilex_hps/
/ip/emif_io96b_hps/emif_io96b_hps/
/ip/f2sdram_adapter/
/ip/hps_subsys/

# generated build-metadata package (rom_info_pkg.vhd, gen_build_metadata.py)
/src/pkg/

# sim run outputs (results, lint logs, waveforms) + tool crash dumps
/sim/
/*hs_err_pid*.log

# rr linux per-stage build logs
/sw/linux/*_build.log
