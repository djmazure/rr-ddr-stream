 			for (i = 0; i < 8; i++)
-				*buf |= (vmem16[((y * 8 * WIDTH) +
-						 (i * WIDTH)) + x] ?
+				*buf |= (vmem16[((y * 8 * w) +
+						 (i * w)) + x] ?
 					 1 : 0) << i;
 			buf++;
 		}
@@ -137,7 +141,7 @@ static int write_vmem(struct fbtft_par *par, size_t offset, size_t len)
 		write_reg(par, 0x00);
 		write_reg(par, LCD_COL_ADDRESS);
 		gpiod_set_value(par->gpio.dc, 1);
-		ret = par->fbtftops.write(par, par->txbuf.buf, WIDTH);
+		ret = par->fbtftops.write(par, par->txbuf.buf, w);
 		gpiod_set_value(par->gpio.dc, 0);
 	}
 
